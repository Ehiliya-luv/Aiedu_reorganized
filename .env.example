# Copy this file to .env locally. Keep the copy untracked.
# The values below are intentionally empty; choose the provider and model used
# by your institution or compatible service.
AIEDU_JUDGE_API_BASE=
AIEDU_JUDGE_API_KEY=
AIEDU_JUDGE_MODEL=
AIEDU_JUDGE_TIMEOUT=300
AIEDU_JUDGE_TEMPERATURE=0
AIEDU_JUDGE_MAX_TOKENS=8192

# Optional provider-specific routing variables. They are only read when the
# selected model name uses the corresponding prefix.
DEEPSEEK_API_BASE=
DEEPSEEK_API_KEY=
DASHSCOPE_API_BASE=
DASHSCOPE_API_KEY=
